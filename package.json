{
  "name": "christmas-tree",
  "homepage": "https://www.weiyirao.com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "photos": "node scripts/prepare-photos.mjs",
    "predev": "npm run photos",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run photos",
    "build": "tsc -b && vite build && node scripts/finalize-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "gh-pages": "^6.3.0",
    "globals": "^15.11.0",
    "typescript": "^5.9.0-beta",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.11",
    "sharp": "^0.34.5",
    "@types/qrcode": "^1.5.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
